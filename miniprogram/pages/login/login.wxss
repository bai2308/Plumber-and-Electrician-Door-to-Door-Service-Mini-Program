.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx 40rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.tips {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.tips.center {
  text-align: center;
  margin-bottom: 30rpx;
}

.btn-wx {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
}

.form {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 30rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 10rpx;
}

.input {
  background: #f5f6f8;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.submit {
  margin-top: 10rpx;
  margin-bottom: 20rpx;
}

.u-row {
  display: flex;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  color: #333;
}

.u-label {
  width: 140rpx;
  color: #999;
}
