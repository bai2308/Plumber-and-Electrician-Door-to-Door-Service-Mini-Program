.month-bar { padding: 20rpx 28rpx; }

.month-pick { font-size: 32rpx; font-weight: 600; color: #1677ff; }

.stat-cards {
  display: flex;
  margin: 20rpx;
  gap: 20rpx;
}

.stat-box {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.stat-box.income {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #fff;
}

.stat-num { font-size: 44rpx; font-weight: 700; }

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-box.income .stat-label { color: rgba(255,255,255,0.85); }

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.dist-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
  color: #666;
}

.trend-item { padding: 24rpx 28rpx; }

.t-top {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.t-price { color: #fa8c16; font-weight: 600; }

.t-bar-bg {
  height: 14rpx;
  background: #f0f2f5;
  border-radius: 8rpx;
  overflow: hidden;
}

.t-bar {
  height: 100%;
  background: linear-gradient(90deg, #1677ff, #69b1ff);
  border-radius: 8rpx;
}
