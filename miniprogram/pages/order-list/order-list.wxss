.search-bar {
  display: flex;
  align-items: center;
}

.login-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 50rpx;
}

.tip-emoji { font-size: 90rpx; margin-bottom: 24rpx; }

.tip-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 50rpx;
}

.search-input {
  flex: 1;
  background: #f5f6f8;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
}

.search-btn { margin-left: 16rpx; }

.order-card { padding: 28rpx; }

.o-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.o-type { font-size: 32rpx; font-weight: 600; }

.o-status { font-size: 26rpx; font-weight: 600; }

.o-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.new-order-btn { margin: 30rpx 20rpx 60rpx; }
