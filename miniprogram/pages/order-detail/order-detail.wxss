.status-card { text-align: center; padding: 40rpx; }

.status-text { font-size: 40rpx; font-weight: 700; }

.status-tip { color: #999; font-size: 24rpx; margin-top: 12rpx; }

.row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child { border-bottom: none; }

.k {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}

.v { flex: 1; }

.price { color: #fa8c16; font-weight: 700; }

.photo-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.photos { display: flex; flex-wrap: wrap; }

.photo {
  width: 190rpx;
  height: 190rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
}

.call-btn { margin: 30rpx 20rpx 60rpx; }
