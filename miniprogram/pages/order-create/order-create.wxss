.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item.column {
  flex-direction: column;
  align-items: stretch;
}

.form-item:last-child { border-bottom: none; }

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.form-item.column .label { margin-bottom: 16rpx; }

input, .picker {
  flex: 1;
  font-size: 28rpx;
}

.placeholder { color: #bbb; }

.textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.photos {
  display: flex;
  flex-wrap: wrap;
}

.photo-box {
  position: relative;
  margin: 0 16rpx 16rpx 0;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 60rpx;
}

.submit-btn {
  margin: 30rpx 20rpx 60rpx;
}
